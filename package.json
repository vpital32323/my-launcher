{
  "name": "my-launcher",
  "productName": "My Launcher",
  "version": "0.1.0",
  "description": "Красивый и плавный лаунчер Minecraft для собственного клиента",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron . --dev\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder"
  },
  "dependencies": {
    "framer-motion": "^11.11.0",
    "minecraft-launcher-core": "^3.18.2",
    "msmc": "^5.0.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.0.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.10",
    "wait-on": "^8.0.1"
  },
  "author": "My Launcher",
  "build": {
    "appId": "com.example.mylauncher",
    "directories": { "output": "release" },
    "files": ["dist/**", "electron/**", "package.json"],
    "win": { "target": "nsis" },
    "mac": { "target": "dmg" },
    "linux": { "target": "AppImage" }
  }
}
